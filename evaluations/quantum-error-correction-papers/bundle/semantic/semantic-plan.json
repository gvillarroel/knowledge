{
  "bundle": {
    "base_iri": "https://example.org/qec-arxiv-papers/",
    "description": "Fifteen version-pinned papers spanning surface codes, qLDPC constructions and decoders, and bosonic quantum error correction.",
    "ontology_iri": "https://example.org/ontology/qec-arxiv-papers",
    "owl_profile": "rl",
    "prefix": "qec",
    "title": "Quantum Error Correction ArXiv Paper Corpus",
    "version_iri": "https://example.org/ontology/qec-arxiv-papers/1.0.0"
  },
  "ontology": {
    "classes": [
      {
        "label": "research paper",
        "name": "Paper"
      }
    ],
    "properties": [
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "paperTitle",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "selectionDimension",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "paperId",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "arxivId",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "arxivVersion",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "publicationYear",
        "range": "xsd:integer"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "authors",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "primaryCategory",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "abstract",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "sourceUrl",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "pdfUrl",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "pdfSha256",
        "range": "xsd:string"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "pageCount",
        "range": "xsd:integer"
      },
      {
        "domain": "Paper",
        "kind": "datatype",
        "name": "extractedCharacters",
        "range": "xsd:integer"
      }
    ]
  },
  "rules": [
    {
      "basis": {
        "kind": "evidence",
        "references": [
          "QEC-ARXIV-SELECTION-1"
        ]
      },
      "datatype": "xsd:string",
      "max_count": 1,
      "message": "Every paper must retain one exact versioned arXiv ID.",
      "min_count": 1,
      "name": "PaperIdentifierRule",
      "path": "paperId",
      "pattern": "^[0-9]{4}\\.[0-9]{4,5}v[0-9]+$",
      "target_class": "Paper"
    },
    {
      "basis": {
        "kind": "evidence",
        "references": [
          "QEC-ARXIV-INVENTORY-1"
        ]
      },
      "datatype": "xsd:string",
      "max_count": 1,
      "message": "Every paper must retain the pinned PDF digest.",
      "min_count": 1,
      "name": "PaperDigestRule",
      "path": "pdfSha256",
      "pattern": "^[0-9a-f]{64}$",
      "target_class": "Paper"
    },
    {
      "basis": {
        "kind": "evidence",
        "references": [
          "QEC-ARXIV-METADATA-1"
        ]
      },
      "datatype": "xsd:string",
      "max_count": 1,
      "message": "Every paper must retain its official arXiv title.",
      "min_count": 1,
      "name": "PaperTitleRule",
      "path": "paperTitle",
      "pattern": ".+",
      "target_class": "Paper"
    }
  ],
  "schema_version": "1.0",
