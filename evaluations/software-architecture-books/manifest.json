{
  "schema_version": "1.0",
  "bundle": {
    "title": "Software architecture and engineering book corpus",
    "description": "A private, page-addressable corpus of eighteen books about software architecture, design, requirements, APIs, delivery, concurrency, and performance.",
    "base_iri": "https://example.org/knowledge/software-architecture-books/",
    "ontology_iri": "https://example.org/ontology/software-architecture-books",
    "version_iri": "https://example.org/ontology/software-architecture-books/1.0.0",
    "prefix": "sab",
    "owl_profile": "rl"
  },
  "ontology": {
    "classes": [
      {
        "name": "BookDocument",
        "label": "software architecture book document"
      }
    ],
    "properties": [
      {
        "name": "author",
        "kind": "datatype",
        "domain": "BookDocument",
        "range": "xsd:string"
      },
      {
        "name": "documentId",
        "kind": "datatype",
        "domain": "BookDocument",
        "range": "xsd:string"
      },
      {
        "name": "pageCount",
        "kind": "datatype",
        "domain": "BookDocument",
        "range": "xsd:integer"
      },
      {
        "name": "pdfSha256",
        "kind": "datatype",
        "domain": "BookDocument",
        "range": "xsd:string"
      }
    ]
  },
  "rules": [
    {
      "name": "BookAuthorRule",
      "target_class": "BookDocument",
      "path": "author",
      "min_count": 1,
      "max_count": 1,
      "datatype": "xsd:string",
      "message": "Each accepted book must identify exactly one author string.",
      "basis": {
        "kind": "operational-policy",
        "references": [
          "book-selection.json"
        ]
      }
    },
    {
      "name": "BookDocumentIdRule",
      "target_class": "BookDocument",
      "path": "documentId",
      "min_count": 1,
      "max_count": 1,
      "datatype": "xsd:string",
      "message": "Each accepted book must identify exactly one stable document ID.",
      "basis": {
        "kind": "operational-policy",
        "references": [
          "book-selection.json"
        ]
      }
    },
    {
      "name": "BookPageCountRule",
      "target_class": "BookDocument",
      "path": "pageCount",
      "min_count": 1,
      "max_count": 1,
      "datatype": "xsd:integer",
      "message": "Each accepted book must preserve its validated PDF page count.",
      "basis": {
        "kind": "operational-policy",
        "references": [
          "book-selection.json"
        ]
      }
    },
    {
      "name": "BookPdfHashRule",
      "target_class": "BookDocument",
      "path": "pdfSha256",
      "min_count": 1,
      "max_count": 1,
      "datatype": "xsd:string",
      "pattern": "^[0-9a-f]{64}$",
      "message": "Each accepted book must preserve its validated lowercase PDF SHA-256.",
      "basis": {
        "kind": "operational-policy",
        "references": [
          "book-selection.json"
        ]
      }
    }
  ],
  "sources": [
    {
      "id": "book-architecture-for-flow",
      "kind": "markdown",
      "path": "processed/sources/markdown/architecture-for-flow.md",
      "concept_type": "Software Architecture Book",
      "ontology_class": "BookDocument",
      "fields": {
        "author": "author",
        "document_id": "documentId",
        "page_count": "pageCount",
        "pdf_sha256": "pdfSha256"
      }
    },
