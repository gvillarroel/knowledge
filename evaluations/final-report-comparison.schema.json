{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-report-comparison/1.0",
  "title": "Aggregate dataset comparison for a final evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "heading",
    "dataset_scope",
    "metrics",
    "alternatives"
  ],
  "properties": {
    "schema_version": {
      "const": "final-report-comparison/1.0"
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string",
      "pattern": "^## "
    },
    "dataset_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "cohort",
        "candidate_budget",
        "identity_grouping",
        "metric_contract"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "cohort": {"type": "string", "minLength": 1},
        "candidate_budget": {"type": "string", "minLength": 1},
        "identity_grouping": {"type": "string", "minLength": 1},
        "metric_contract": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "unit",
          "aggregation",
          "direction",
          "display_precision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {"type": "string", "minLength": 1},
          "unit": {
            "enum": ["percent", "score", "ms", "seconds", "count", "bytes"]
          },
          "aggregation": {
            "enum": ["mean", "ratio", "percentile_50", "percentile_95", "sum", "count"]
          },
          "direction": {
            "enum": ["higher", "lower"]
          },
          "display_precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "metrics"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
